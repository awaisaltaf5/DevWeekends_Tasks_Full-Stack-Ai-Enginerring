# ---------------------------------------------------------------------------
# StayNest backend environment template.
#
# Copy this file to `.env` and fill in your own values. NEVER commit your real
# `.env` file. NEVER paste real credentials into this template — use the plain
# placeholder values shown below.
# ---------------------------------------------------------------------------

PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
