# Copy to .env and fill with your own values.
# Only variables prefixed with VITE_ are exposed to the client.
VITE_API_URL=http://localhost:5000/api

# Unsplash public API access key (for resilient/validated hotel imagery).
# Kept out of the real .env template to avoid committing secrets. New key:
#   https://unsplash.com/developers  ->  "Your applications"
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key

