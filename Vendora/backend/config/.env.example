# Vendora backend environment (copy to backend/config/.env)
NODE_ENV=development
PORT=8000

# Database (MongoDB Atlas — Mongoose)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vendora?retryWrites=true&w=majority

# Auth secrets
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES=7d
ACTIVATION_SECRET=change_me_to_another_long_random_string

# Frontend URL (used for CORS + account activation links)
CLIENT_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=

# SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address — MUST be a sender/domain VERIFIED in your Brevo account, otherwise the
# mail is queued but silently dropped (or flagged as spam). The Brevo relay sender
# (your SMTP_USER above) always works; for a custom address like you@yourdomain.com,
# verify it in Brevo → Senders before delivery succeeds.
EMAIL_FROM=Vendora <you@example.com>

# EmailJS (HTTP API) — PRIMARY transport when configured (otherwise SMTP above is used).
# Get these from https://dashboard.emailjs.com :
#   - EMAILJS_SERVICE_ID       : your EmailJS service id (e.g. service_xxxx)
#   - EMAILJS_PUBLIC_KEY       : account public key (Dashboard → Integration tab)
#   - EMAILJS_TEMPLATE_DEFAULT : template_id for general flows (e.g. Welcome shell)
#   - EMAILJS_TEMPLATE_ORDER   : template_id for order flows (Order Confirmation shell)
# In EACH template configure:
#   - "To email"   = {{user_email}}      (recipient comes from the send call)
#   - "Subject"    = {{subject}}         (dynamic subject)
#   - body (HTML)  = {{message_html}}    (full branded HTML injected from emailTemplates.js)
# sendMail routes order confirmations (buyer orderConfirmation + sellerNewOrder) to
# EMAILJS_TEMPLATE_ORDER and every other flow to EMAILJS_TEMPLATE_DEFAULT.
# Override per call with { templateId } in a controller.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_DEFAULT=
EMAILJS_TEMPLATE_ORDER=

# Unsplash (backend only — for seed images; the key is never sent to the frontend)
UNSPLASH_ACCESS_KEY=

# Stripe — keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Publishable key (safe to expose — served to the frontend via /api/v2/payment/stripeapikey)
STRIPE_PUBLISHABLE_KEY=
# For webhook signature verification (Stripe Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=
# Optional — defaults to "usd"
STRIPE_CURRENCY=usd

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
