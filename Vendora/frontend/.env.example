# Vendora frontend environment (copy to frontend/.env)
# CRA reads REACT_APP_* at build time. These must only ever point to public URLs —
# never expose backend secrets here.
REACT_APP_API_URL=http://localhost:8000/api/v2
REACT_APP_SOCKET_URL=http://localhost:4000
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id
