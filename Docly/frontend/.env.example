# Copy this file to .env and fill in real values. Never commit real secrets.

# Base URL for the Docly backend API (used by the axios client).
# Points directly at the deployed backend API base. Browser requests go
# cross-origin, so the backend CORS (CLIENT_ORIGIN) must include the frontend
# origin (https://docly-alpha.vercel.app). For local dev leave "/api" (the Vite
# proxy forwards it to http://localhost:5000).
VITE_API_URL=https://docly-backend.vercel.app/api

# Google Identity Services web client ID. Same value as the backend
# GOOGLE_CLIENT_ID. Leave empty to disable Google sign-in.
VITE_GOOGLE_CLIENT_ID=546325762666-4viitvr25ccjhe5k11lihralrup9k69e.apps.googleusercontent.com

# Exact origins that Google must allow for this client. Add the live frontend
# origin here too (e.g. https://docly-frontend.vercel.app) AND in the Google
# OAuth Console under "Authorized JavaScript origins".
VITE_GOOGLE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://docly-nine.vercel.app

# PUBLIC Cloudinary delivery URL for the homepage hero background video (production).
# Only a public delivery URL — never expose Cloudinary API keys/secrets here.
# Leave empty to use the local bundled asset at /videos/docly-hero-background.mp4.
VITE_HERO_VIDEO_URL=