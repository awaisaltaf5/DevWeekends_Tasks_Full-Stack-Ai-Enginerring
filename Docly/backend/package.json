{
  "name": "docly-backend",
  "version": "0.1.0",
  "description": "Docly — Doctor Booking & Telemedicine: Express + MongoDB Atlas (Mongoose) + TypeScript API with JWT role-based authentication.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/scripts/smoke.ts",
    "test:auth": "tsx src/scripts/testAuthFlow.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:admin": "tsx src/scripts/createAdmin.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "mongoose",
    "jwt",
    "bcryptjs",
    "role-based-access",
    "rest-api"
  ],
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "resend": "^6.22.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^7.0.2"
  }
}
