{
  "include": ["src", "api"],
  "compilerOptions": {
    "outDir": ".build",
    "rootDir": ".",
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  }
}