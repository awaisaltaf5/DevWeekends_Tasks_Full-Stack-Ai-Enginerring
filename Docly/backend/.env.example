# Copy this file to .env and fill in real values. Never commit real secrets.

# MongoDB Atlas connection string. Add your own real URI here.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/docly
MONGODB_URI=

# Secret used to sign JWTs. Use a long random string (32+ chars) in production.
JWT_SECRET=change-me-in-production

# JWT lifetime, e.g. 7d / 30d / 1h.
JWT_EXPIRES_IN=7d

# Server port.
PORT=5000

# development | production | test
NODE_ENV=development

# Allowed CORS origin(s), comma-separated. Leave empty to allow all (dev).
CLIENT_ORIGIN=http://localhost:3000

# Google Identity Services web client ID. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Optional: seed an admin account via `npm run seed:admin`.
ADMIN_NAME=Docly Admin
ADMIN_EMAIL=admin@docly.com
ADMIN_PASSWORD=

# Optional: Cloudinary — used for doctor profile image uploads.
# Add your own Cloudinary credentials here when image upload is needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Video consultations (Jitsi).
# JITSI_APP_ID and JITSI_APP_SECRET are used to sign short-lived participant
# tokens. The APP_ID may be exposed to the frontend; the APP_SECRET must stay
# server-side only.
JITSI_APP_ID=
JITSI_APP_SECRET=
# JaaS host, normally 8x8.vc. Use meet.jit.si only for unauthenticated rooms.
JITSI_DOMAIN=8x8.vc

# Email notifications via Brevo SMTP (preferred).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender must be configured/verified in Brevo.
EMAIL_FROM=Docly <your-verified-sender@example.com>

# Optional Resend fallback.
RESEND_API_KEY=
# Public base URL of the frontend (used to build links inside emails).
CLIENT_URL=http://localhost:3000