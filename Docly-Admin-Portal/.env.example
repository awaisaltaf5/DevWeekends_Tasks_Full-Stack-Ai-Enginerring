# Docly Admin Portal Configuration
# Copy this file to .env and fill in real values. Never commit real secrets.

# Base URL for the Docly backend API.
# For production: https://docly-backend.vercel.app/api
# For local dev:    http://localhost:5000/api
VITE_API_URL=https://docly-backend.vercel.app/api

# Admin credentials are validated server-side by the backend only.
# The VITE_ADMIN_USERNAME / VITE_ADMIN_PASSWORD / VITE_ADMIN_JWT_SECRET
# variables have been REMOVED from the frontend to avoid bundling secrets.
#
# Configure admin credentials in the BACKEND .env instead:
#   ADMIN_USERNAME=admin
#   ADMIN_PASSWORD=<strong password>
#   ADMIN_NAME=System Administrator
#   ADMIN_EMAIL=admin@docly.com
#   ADMIN_JWT_SECRET=<your jwt secret>
#
# For production deployment:
#   VITE_API_URL=https://your-docly-backend.vercel.app/api
